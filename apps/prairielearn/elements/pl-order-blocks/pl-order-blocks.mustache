{{#question}}
<script>
$(function() {
    var UUID = "{{uuid}}";

    new window.PLOrderBlocks(UUID, {
        maxIndent: {{max_indent}},
        inline: {{inline}},
        enableIndentation: {{check_indentation}},
    });
});
</script>


    <div
        class="d-flex flex-wrap pl-order-blocks-question-{{uuid}}"
        dir="ltr"
        data-ordering-required="{{ordering_required}}"
        data-indentation-required="{{check_indentation}}"
    >
        <div class="pl-order-blocks-container {{block_layout}} {{block_scroll}} {{dropzone_layout}} " >
            <div class="card-header pl-order-blocks-header bg-primary-subtle" dir="rtl">
                <span>{{source-header}}</span>
                <button type="button" class="btn btn-light btn-sm align-middle" data-bs-toggle="popover" data-bs-html="true" data-bs-container="body" data-bs-placement="auto" data-bs-custom-class="sh-rtl-popover" title="راهنمای مرتب‌سازی بلوک‌ها" data-bs-content="{{help_text}}">
                    <i class="fas fa-question-circle" aria-hidden="true"></i>
                </button>
            </div>
            <ul id="order-blocks-options-{{uuid}}" role="listbox" name="{{answer_name}}" class="card-body list-group pl-order-blocks-connected-sortable" aria-label="ناحیه بلوک‌های گزینه">
                {{#options}}
                    <li class="{{block_formatting}} shadow pl-order-block {{^editable}}nodrag{{/editable}}"
                        uuid="{{uuid}}"
                        string="{{inner_html}}"
                        data-indent-depth="{{indent_depth}}"
                        {{#distractor_bin}}data-distractor-bin="{{distractor_bin}}"{{/distractor_bin}}
                        role="option"
                        tabindex="0">
                        <div class="pl-order-block-row">
                            <div class="pl-order-block-handle" aria-hidden="true">
                                <i class="bi bi-grip-vertical"></i>
                            </div>
                            <div class="pl-order-block-content">
                                {{{inner_html}}}
                            </div>
                        </div>
                    </li>
                {{/options}}
            </ul>
        </div>
        <div class="pl-order-blocks-container form-control {{#parse-error}}has-validation is-invalid{{/parse-error}} {{block_layout}} {{block_scroll}} {{dropzone_layout}}">
            <div class="card-header pl-order-blocks-header bg-primary-subtle" dir="rtl">
                <span>
                    {{solution-header}}
                    {{#submission_was_graded}}
                        {{#correct}}
                            <span class="badge text-bg-success"><i class="fas fa-check" aria-hidden="true"></i> 100%</span>
                        {{/correct}}
                        {{#partially_correct}}
                            <span class="badge text-bg-warning"><i class="fas fa-times" aria-hidden="true"></i> {{partially_correct}}%</span>
                        {{/partially_correct}}
                        {{#incorrect}}
                            <span class="badge text-bg-danger"><i class="fas fa-times" aria-hidden="true"></i> 0%</span>
                        {{/incorrect}}
                    {{/submission_was_graded}}
                </span>
            </div>
            <ul id="order-blocks-dropzone-{{uuid}}" role="listbox" name="{{answer_name}}" class="card-body list-group pl-order-blocks-connected-sortable dropzone" aria-label="ناحیه چیدمان پاسخ" {{#parse-error}}aria-invalid="true" aria-errormessage="pl-order-blocks-{{uuid}}-error"{{/parse-error}}>
                {{#submission_dict}}
                    <li class="{{block_formatting}} shadow pl-order-block {{^editable}}nodrag{{/editable}}"
                        style="margin-left: calc(var(--pl-order-block-indent-ch, 4) * {{indent_depth}} * 1ch);"
                        uuid="{{uuid}}"
                        string="{{inner_html}}"
                        data-indent-depth="{{indent_depth}}"
                        {{#distractor_bin}}data-distractor-bin="{{distractor_bin}}"{{/distractor_bin}}
                        role="option"
                        tabindex="0">
                        <div class="pl-order-block-row">
                            <div class="pl-order-block-handle" aria-hidden="true">
                                <i class="bi bi-grip-vertical"></i>
                            </div>
                            <div class="pl-order-block-content">
                                {{{inner_html}}}
                            </div>
                        </div>
                    </li>
                {{/submission_dict}}
            </ul>
        </div>

    {{! TODO: this invalid-feedback block is duplicated in the submission panel below; extract into a shared chevron partial if elements adopt partials. }}
    {{#parse-error}}
        <span id="pl-order-blocks-{{uuid}}-error" class="invalid-feedback d-block" dir="rtl">
            <span class="badge text-bg-danger">
                نامعتبر
                <i class="fas fa-exclamation-triangle" aria-hidden="true"></i>
            </span>
            <a
                class="link-primary"
                tabindex="0"
                role="button"
                data-bs-placement="auto"
                data-bs-toggle="popover"
                data-bs-html="true"
                data-bs-custom-class="sh-rtl-popover"
                title="خطای قالب"
                data-bs-content="{{parse-error}}"
            >
                اطلاعات بیشتر…
            </a>
        </span>
    {{/parse-error}}

    </div>
    <input id="{{uuid}}-input" type="hidden" name="{{answer_name}}-input" value=""/>

{{/question}}

{{#submission}}
    {{^parse-error}}
    <div class="pl-order-blocks-answer-container {{block_layout}} {{block_scroll}} {{dropzone_layout}}" dir="ltr">
        <div class="card-header" dir="rtl">
            پاسخ شما:
        {{#correct}}
            <span class="badge text-bg-success"><i class="fas fa-check" aria-hidden="true"></i> 100%</span>
        {{/correct}}
        {{#partially_correct}}
            <span class="badge text-bg-warning"><i class="fas fa-times" aria-hidden="true"></i> {{partially_correct}}%</span>
        {{/partially_correct}}
        {{#incorrect}}
            <span class="badge text-bg-danger"><i class="fas fa-times" aria-hidden="true"></i> 0%</span>
        {{/incorrect}}
        </div>
        <ul class="card-body list-group list-unstyled">
            {{#student_submission}}
                {{#distractor_feedback}}
                <li class="pl-order-blocks-pairing-indicator bg-warning-subtle">
                    <ul class="list-unstyled">
                        <li>
                            <div class="pl-order-blocks-correctness-badge-container">
                                {{#allow_feedback_badges}}
                                <span class="pl-order-blocks-correctness-badge badge {{badge_type}}"><i class="fas {{icon}}" aria-hidden="true"></i></span>
                                {{/allow_feedback_badges}}
                                <div class="{{block_formatting}} pl-order-block" style="margin-left: calc(var(--pl-order-block-indent-ch, 4) * {{indent_depth}} * 1ch);flex-grow:1;">{{{inner_html}}}</div>
                            </div>
                        </li>
                    </ul>
                    <div>
                        <span class="pl-order-blocks-feedback-icon"><i class="fas fa-question-circle" aria-hidden="true"></i></span>
                        {{distractor_feedback}}
                    </div>
                </li>
                {{/distractor_feedback}}
                {{^distractor_feedback}}
                    {{#ordering_feedback}}
                    <li class="pl-order-blocks-pairing-indicator bg-warning-subtle">
                        <ul class="list-unstyled">
                            <li>
                                <div class="pl-order-blocks-correctness-badge-container">
                                    {{#allow_feedback_badges}}
                                    <span class="pl-order-blocks-correctness-badge badge {{badge_type}}"><i class="fas {{icon}}" aria-hidden="true"></i></span>
                                    {{/allow_feedback_badges}}
                                    <div class="{{block_formatting}} pl-order-block" style="margin-left: calc(var(--pl-order-block-indent-ch, 4) * {{indent_depth}} * 1ch);flex-grow:1;">{{{inner_html}}}</div>
                                </div>
                            </li>
                        </ul>
                        <div>
                            <span class="pl-order-blocks-feedback-icon"><i class="fas fa-question-circle" aria-hidden="true"></i></span>
                            {{ordering_feedback}}
                        </div>
                    </li>
                    {{/ordering_feedback}}
                    {{^ordering_feedback}}
                    <li>
                        <div class="pl-order-blocks-correctness-badge-container">
                            {{#allow_feedback_badges}}
                            <span class="pl-order-blocks-correctness-badge badge {{badge_type}}"><i class="fas {{icon}}" aria-hidden="true"></i></span>
                            {{/allow_feedback_badges}}
                            <div class="{{block_formatting}} pl-order-block" style="margin-left: calc(var(--pl-order-block-indent-ch, 4) * {{indent_depth}} * 1ch);flex-grow:1;">{{{inner_html}}}</div>
                        </div>
                    </li>
                    {{/ordering_feedback}}
                {{/distractor_feedback}}
            {{/student_submission}}
        </ul>
    </div>
    <div dir="rtl" class="mt-2">{{{feedback}}}</div>
    {{/parse-error}}

    {{#parse-error}}
        <span id="pl-order-blocks-{{uuid}}-error" class="invalid-feedback d-block" dir="rtl">
            <span class="badge text-bg-danger">
                نامعتبر
                <i class="fas fa-exclamation-triangle" aria-hidden="true"></i>
            </span>
            <a
                class="link-primary"
                tabindex="0"
                role="button"
                data-bs-placement="auto"
                data-bs-toggle="popover"
                data-bs-html="true"
                data-bs-custom-class="sh-rtl-popover"
                title="خطای قالب"
                data-bs-content="{{parse-error}}"
            >
                اطلاعات بیشتر…
            </a>
        </span>
    {{/parse-error}}
{{/submission}}

{{#true_answer}}
    <div class="pl-order-blocks-answer-container pl-order-blocks-correct-answer {{block_layout}} {{block_scroll}} {{dropzone_layout}}" dir="ltr">
        <div class="card-header bg-success-subtle" dir="rtl">پاسخ صحیح ({{ordering_message}}{{indentation_message}}):</div>
        <ul class="card-body list-group">
        {{#question_solution}}
            <li class="{{block_formatting}} pl-order-block" style="margin-left: calc(var(--pl-order-block-indent-ch, 4) * {{indent_depth}} * 1ch)">{{{inner_html}}}</li>
        {{/question_solution}}
        </ul>
    </div>

    {{#show_distractors}}
    <br><br>
    <div class="pl-order-blocks-answer-container pl-order-blocks-distractors {{block_layout}} {{block_scroll}} {{dropzone_layout}}" dir="ltr">
        <div class="card-header bg-danger-subtle" dir="rtl">بلوک‌های نادرست (این بلوک‌ها نباید در پاسخ نهایی شما باشند):</div>
        <ul class="card-body list-group list-unstyled">
        {{#distractors}}
            {{#distractor_feedback}}
            <li class="pl-order-blocks-pairing-indicator bg-warning-subtle">
                <ul class="p-0">
                    <li class="{{block_formatting}} pl-order-block">{{{inner_html}}}</li>
                </ul>
                <div>
                    <span class="pl-order-blocks-feedback-icon"><i class="fas fa-question-circle" aria-hidden="true"></i></span>
                    {{distractor_feedback}}
                </div>
            </li>
            {{/distractor_feedback}}
            {{^distractor_feedback}}
                <li class="{{block_formatting}} pl-order-block">{{{inner_html}}}</li>
            {{/distractor_feedback}}
        {{/distractors}}
        </ul>
    </div>
    {{/show_distractors}}
{{/true_answer}}
