{{#graded}}
<div class="pl-external-grader-results">
  {{^grading_succeeded}}
    <h3 class="text-danger"><i class="fa fa-exclamation-triangle me-1"></i> خطا در فرآیند تصحیح خودکار</h3>
    {{#message}}
      <pre class="bg-dark text-white rounded p-3 my-3" dir="ltr"><code>{{{message}}}</code></pre>
    {{/message}}
    {{^message}}
      <pre class="bg-dark text-white rounded p-3 my-3"><code>خطای نامشخص در سامانه ارزیابی؛ لطفاً به دستیاران آموزشی اطلاع دهید.</code></pre>
    {{/message}}
  {{/grading_succeeded}}
  {{#grading_succeeded}}
    <h3>
      {{^gradable}}
          <span class="badge bg-warning text-dark">پاسخ غیرقابل نمره‌دهی (Invalid)</span>
      {{/gradable}}
      {{#gradable}}
          نمره آزمون:
          <span style="color: {{results_color}}" dir="ltr">
              {{#points}}
                  <strong>{{points}} / {{max_points}} ({{score}}%)</strong>
              {{/points}}
              {{^points}}
                  <strong>{{score}}%</strong>
              {{/points}}
          </span>
      {{/gradable}}
    </h3>
    {{#has_format_errors}}
        <div class="my-3">
        {{#format_errors}}
            <div class="alert alert-danger"><strong>خطای فرمت:</strong> {{.}}</div>
        {{/format_errors}}
        </div>
    {{/has_format_errors}}
    {{#has_message_or_output_or_image}}
      {{#has_message}}
        <div class="card my-3">
          <div class="card-header">پیام سیستم تصحیح</div>
          <pre class="bg-dark text-white p-3 mb-0" dir="ltr"><code>{{{message}}}</code></pre>
        </div>
      {{/has_message}}
      {{#has_output}}
        <div class="card my-3">
          <div class="card-header">خروجی برنامه (Output)</div>
          <pre class="bg-dark text-white p-3 mb-0" dir="ltr"><code>{{{output}}}</code></pre>
        </div>
      {{/has_output}}
      {{#has_images}}
          <ul class="list-group list-group-flush">
              <li class="list-group-item">
                {{#images}}
                  <figure class="figure">
                    <figcaption><strong>{{label}}{{^label}}تصویر خروجی{{/label}}</strong></figcaption>
                    <img class="figure-img img-fluid" src="{{url}}{{^url}}{{.}}{{/url}}"/>
                  </figure>
                {{/images}}
              </li>
          </ul>
      {{/has_images}}
    {{/has_message_or_output_or_image}}
    {{#has_tests}}
      <h3 class="mt-4 mb-3"><i class="fa fa-vial-circle-check me-2"></i> نتایج آزمون‌های خودکار (تست‌کیس‌ها)</h3>
      <div class="my-3">
      {{#tests_missing_points}}
        <div class="alert alert-warning mb-3">یک یا چند آزمون فاقد مقدار نمره بودند و برخی جزئیات نمره‌دهی پنهان است.</div>
      {{/tests_missing_points}}
      {{#tests}}
        <div class="card mb-2">
          <button type="button" class="card-header d-flex align-items-center collapsed border-top-0 border-start-0 border-end-0 text-start" data-bs-toggle="collapse" data-bs-target="#card-{{uuid}}-{{index}}" aria-expanded="false" aria-controls="card-{{uuid}}-{{index}}">
            <div class="card-title mb-0 me-auto d-flex align-items-center">
              {{#show_points}}
                <i class="fas {{results_icon}} me-2" aria-hidden="true" style="color: {{results_color}}"></i>
                <span class="me-2" style="color: {{results_color}};" dir="ltr"><strong>[{{points}} / {{max_points}}]</strong></span>
              {{/show_points}}
              <span class="ms-1">{{name}}</span>
            </div>
            <div class="ms-2">
              <span class="fas fa-angle-down"></span>
            </div>
          </button>
          <div id="card-{{uuid}}-{{index}}" class="collapse">
            <ul class="list-group list-group-flush">
              {{#has_description}}
                <li class="list-group-item"><strong>شرح آزمون:</strong> {{description}}</li>
              {{/has_description}}
              {{#show_points}}
                <li class="list-group-item"><strong>حداکثر نمره:</strong> <span dir="ltr">{{max_points}}</span></li>
                <li class="list-group-item"><strong>نمره کسب‌شده:</strong> <span dir="ltr">{{points}}</span></li>
              {{/show_points}}
              {{#has_message}}
                  <li class="list-group-item">
                      <div class="mb-2"><strong>پیام ارزیاب:</strong></div>
                      <pre class="bg-dark text-white rounded p-3 mb-2" dir="ltr"><code>{{{message}}}</code></pre>
                  </li>
              {{/has_message}}
              {{#has_output}}
                  <li class="list-group-item">
                      <div class="mb-2"><strong>خروجی کنسول:</strong></div>
                      <pre class="bg-dark text-white rounded p-3 mb-2" dir="ltr"><code>{{{output}}}</code></pre>
                  </li>
              {{/has_output}}
              {{#has_images}}
                  <li class="list-group-item">
                      {{#images}}
                      <figure class="figure">
                        <figcaption><strong>{{label}}{{^label}}تصویر خروجی{{/label}}</strong></figcaption>
                        <img class="figure-img img-fluid" src="{{url}}{{^url}}{{.}}{{/url}}"/>
                      </figure>
                      {{/images}}
                  </li>
              {{/has_images}}
            </ul>
          </div>
        </div>
      {{/tests}}
      </div>
    {{/has_tests}}
  {{/grading_succeeded}}
</div>
{{/graded}}
